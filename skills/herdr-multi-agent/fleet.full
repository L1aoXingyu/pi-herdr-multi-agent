# Heavy / max-diversity fleet — author's full nine.
# Use when quota allows or for high-stakes reviews:
#   bash launch.sh ... --fleet-file "$SKILL_DIR/fleet.full"
#
# Daily default is fleet.defaults (usual seven). Same line format.
# Add-back remaining diversity on top of the seven:
#   mimopro + dsflash (non-SF DeepSeek path)
# Daily Go seats are glm53 + hy3 (Go quota 8x).
# Zen free seat is oxalpha (opencode/x-preview-f-free:max).
# SiliconFlow daily seat is dsv4flash (V4-Flash-0731).
# glm52, k27code, dsv4pro, and dots3 are out of both fleets.
# Kimi K3 is cursor-cli only (k3max); opencode-go k3 is out of both fleets.
# qwen38max is out unless explicitly --agent'd.

gpt56sol=openai-codex/gpt-5.6-sol:xhigh
glm53=opencode-go/glm-5.3:max
mimopro=opencode-go/mimo-v2.5-pro:max
hy3=opencode-go/hy3:max
oxalpha=opencode/x-preview-f-free:max
dsv4flash=siliconflow/deepseek-ai/DeepSeek-V4-Flash:max
dsflash=deepseek/deepseek-v4-flash:max
fable5=cursor:claude-fable-5-thinking-high
k3max=cursor:kimi-k3-max
